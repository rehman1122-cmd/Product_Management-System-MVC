@model Product
@{
    ViewData["Title"] = "Delete watch";
}

<section class="page-heading">
    <p class="eyebrow">Watch collection</p>
    <h1>Delete watch</h1>
    <p>Are you sure you want to permanently remove this watch?</p>
</section>

<dl class="details-card">
    <div><dt>Watch</dt><dd>@Model.Name</dd></div>
    <div><dt>Brand</dt><dd>@Model.Brand</dd></div>
    <div><dt>Price</dt><dd>@Model.Price.ToString("C2")</dd></div>
    <div><dt>Units in stock</dt><dd>@Model.Stock</dd></div>
</dl>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="form-actions">
    <button class="button button-danger" type="submit">Delete watch</button>
    <a class="button button-text" asp-action="Index">Cancel</a>
</form>
