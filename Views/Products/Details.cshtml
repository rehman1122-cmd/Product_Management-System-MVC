@model Product
@{
    ViewData["Title"] = "Watch details";
}

<section class="page-heading">
    <p class="eyebrow">@Model.Brand</p>
    <h1>@Model.Name</h1>
    <p>Watch details from the Elite Watches inventory.</p>
</section>

<dl class="details-card">
    <div><dt>Brand</dt><dd>@Model.Brand</dd></div>
    <div><dt>Price</dt><dd>@Model.Price.ToString("C2")</dd></div>
    <div><dt>Units in stock</dt><dd>@Model.Stock</dd></div>
    <div class="details-wide"><dt>Description</dt><dd>@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</dd></div>
</dl>
<div class="form-actions">
    <a class="button button-gold" asp-action="Edit" asp-route-id="@Model.Id">Edit watch</a>
    <a class="button button-text" asp-action="Index">Back to collection</a>
</div>
