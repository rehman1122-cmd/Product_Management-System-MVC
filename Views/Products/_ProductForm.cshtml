@model Product

<div asp-validation-summary="ModelOnly" class="validation-summary"></div>
<div class="form-grid">
    <div class="form-field">
        <label asp-for="Name"></label>
        <input asp-for="Name" autocomplete="off" />
        <span asp-validation-for="Name" class="field-error"></span>
    </div>
    <div class="form-field">
        <label asp-for="Brand"></label>
        <input asp-for="Brand" autocomplete="off" />
        <span asp-validation-for="Brand" class="field-error"></span>
    </div>
    <div class="form-field">
        <label asp-for="Price"></label>
        <input asp-for="Price" type="number" step="0.01" min="0.01" />
        <span asp-validation-for="Price" class="field-error"></span>
    </div>
    <div class="form-field">
        <label asp-for="Stock"></label>
        <input asp-for="Stock" type="number" min="0" />
        <span asp-validation-for="Stock" class="field-error"></span>
    </div>
    <div class="form-field form-field-wide">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" rows="4"></textarea>
        <span asp-validation-for="Description" class="field-error"></span>
    </div>
</div>
