@model Product
@{
    ViewData["Title"] = "Edit watch";
}

<section class="page-heading">
    <p class="eyebrow">Watch collection</p>
    <h1>Edit watch</h1>
    <p>Update the details for <strong>@Model.Name</strong>.</p>
</section>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="editor-form">
    <input asp-for="Id" type="hidden" />
    <partial name="_ProductForm" model="Model" />
    <div class="form-actions">
        <button class="button button-gold" type="submit">Save changes</button>
        <a class="button button-text" asp-action="Index">Cancel</a>
    </div>
</form>
